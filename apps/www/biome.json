{
  "$schema": "https://biomejs.dev/schemas/2.3.7/schema.json",
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 100,
    "attributePosition": "auto"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "useImportType": "off"
      },
      "correctness": {
        "useExhaustiveDependencies": "off",
        "noUnusedImports": "error"
      }
    }
  },
  "javascript": {
    "formatter": {
      "jsxQuoteStyle": "double",
      "quoteProperties": "preserve",
      "trailingCommas": "es5",
      "semicolons": "always",
      "arrowParentheses": "always",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "quoteStyle": "single"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "files": {
    "includes": [
      "app/**/*.{js,jsx,ts,tsx,json}",
      "components/**/*.{js,jsx,ts,tsx,json}",
      "lib/**/*.{js,jsx,ts,tsx,json}",
      "hooks/**/*.{js,jsx,ts,tsx,json}",
      "*.{js,jsx,ts,tsx,json}"
    ],
    "experimentalScannerIgnores": [
      "**/node_modules",
      "**/dist",
      "**/build",
      "**/.next",
      "**/.expo",
      "**/.eas"
    ]
  }
}
