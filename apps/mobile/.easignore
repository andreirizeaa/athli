# NOTE: .env.local is NOT ignored - it will be uploaded to EAS for builds
# Make sure to configure environment-specific secrets in EAS Secrets for production builds

# IMPORTANT: Exclude entire ios/ and android/ directories
# EAS will generate these during prebuild automatically
ios
android

# Node modules (already handled by EAS)
node_modules

# Local build artifacts
.expo
dist
web-build

# IDE
.vscode
.idea

# OS
.DS_Store
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
