{
  "name": "@athli/shared-types",
  "version": "1.0.0",
  "description": "Shared TypeScript types for Athli workout schema - ensures web and mobile apps stay in sync",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./schemas": "./src/schemas/index.ts",
    "./functions": "./src/functions/index.ts",
    "./constants": "./src/constants/index.ts",
    "./workout-schema": "./src/schemas/workout-schema.ts",
    "./payload-builder": "./src/functions/payload-builder.ts",
    "./payload-converter": "./src/functions/payload-converter.ts",
    "./form-schema": "./src/schemas/form-schema.ts",
    "./metric-schema": "./src/schemas/metric-schema.ts",
    "./habit-schema": "./src/schemas/habit-schema.ts",
    "./todo-schema": "./src/schemas/todo-schema.ts",
    "./file-schema": "./src/schemas/file-schema.ts",
    "./client-schema": "./src/schemas/client-schema.ts",
    "./messaging-schema": "./src/schemas/messaging-schema.ts",
    "./messaging-constants": "./src/constants/messaging-constants.ts",
    "./messaging-utils": "./src/functions/messaging-utils.ts",
    "./training-constants": "./src/constants/training-constants.ts",
    "./pdf-template": "./src/functions/pdf-template.ts",
    "./src/functions/pdf-template": "./src/functions/pdf-template.ts",
    "./notification-constants": "./src/constants/notification-constants.ts",
    "./src/constants/notification-constants": "./src/constants/notification-constants.ts"
  },
  "scripts": {
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "athli",
    "shared",
    "types",
    "workout",
    "schema"
  ],
  "author": "Athli",
  "license": "UNLICENSED",
  "private": true,
  "devDependencies": {
    "typescript": "^5.3.3"
  }
}
