{
  "name": "athli-monorepo",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.2.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "overrides": {
    "ajv": "^8.17.1",
    "ajv-keywords": "^5.1.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "prepare": "node -e \"try { require('husky').install() } catch (e) {}\"",
    "android": "cd apps/mobile && expo run:android",
    "ios": "cd apps/mobile && expo run:ios"
  },
  "dependencies": {
    "@react-navigation/drawer": "^7.7.11",
    "expo-image": "~3.0.11",
    "libphonenumber-js": "^1.12.33",
    "next": "16.0.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native-drawer-layout": "^4.2.1",
    "rn-emoji-keyboard": "^1.7.0"
  },
  "devDependencies": {
    "@types/uuid": "^9.0.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "metro-minify-terser": "^0.83.3",
    "metro-runtime": "^0.83.3",
    "turbo": "latest"
  }
}
