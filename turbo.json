{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "build/**"],
      "env": [
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_WWW_URL",
        "CLERK_SECRET_KEY",
        "CLERK_FRONTEND_API_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "CONVEX_DEPLOYMENT"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "start": {
      "cache": false,
      "persistent": true
    }
  }
}

