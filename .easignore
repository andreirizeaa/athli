# CRITICAL: Exclude all other apps in monorepo - only mobile should be uploaded
apps/web
apps/service
apps/marketing
apps/docs

# Exclude root-level non-app directories
docs
sessionmanager-bundle

# Exclude git history
.git

# Exclude build caches
.next
.turbo
**/.next
**/.turbo

# Exclude root-level node_modules (monorepo dependencies)
/node_modules

# Ignore native directories in mobile app - these are rebuilt by EAS prebuild
apps/mobile/ios
apps/mobile/android

# Ignore expo cache
apps/mobile/.expo
**/.expo

# Ignore build artifacts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Ignore IDE
.idea
.vscode

# Ignore OS files
.DS_Store
Thumbs.db

# Ignore husky hooks (not needed for build)
.husky







