# CRITICAL: Exclude all other apps in monorepo - only athli-mobile should be uploaded
apps/athli-web-app
apps/athli-web-api
apps/athli-landing-page

# Exclude root-level node_modules (monorepo dependencies)
/node_modules

# Ignore native directories in mobile app - these are rebuilt by EAS prebuild
apps/athli-mobile/ios/
apps/athli-mobile/android/
apps/athli-mobile/ios/**
apps/athli-mobile/android/**

# Ignore expo cache
apps/athli-mobile/.expo
**/.expo

# Ignore build artifacts
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# Ignore IDE
.idea
.vscode

# Ignore OS files
.DS_Store
Thumbs.db











